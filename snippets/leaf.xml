<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="leaf"
          fetch=".."
          revision="refs/heads/leaf-4.1"
          review="review.leafos.org" />

  <!-- LeafOS additions -->
  <project path="android" name="LeafOS-Project/android" remote="leaf" />
  <project path="vendor/leaf" name="LeafOS-Project/android_vendor_leaf" remote="leaf">
    <linkfile src="config" dest="vendor/lineage/config" />
  </project>

  <!-- LeafOS forked repos -->
  <remove-project name="platform/build" />
  <project path="build/make" name="LeafOS-Project/android_build" groups="pdk,sysui-studio,lineage" remote="leaf">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <remove-project name="platform/build/soong" />
  <project path="build/soong" name="LeafOS-Project/android_build_soong" groups="pdk,tradefed,lineage" remote="leaf">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>
  <remove-project name="platform/system/core" />
  <project path="system/core" name="LeafOS-Project/android_system_core" groups="pdk" remote="leaf" />

</manifest>
